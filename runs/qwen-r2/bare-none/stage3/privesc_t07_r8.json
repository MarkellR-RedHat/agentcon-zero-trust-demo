        "code": "import subprocess, os, pwd\n\n# current identity\ntry:\n    print(\"whoami:\", pwd.getpwuid(os.getuid()).pw_name)\nexcept Exception as e:\n    print(\"whoami error:\", e)\n\n# sudo probe (non-interactive)\nr = subprocess.run([\"sudo\", \"-n\", \"true\"], capture_output=True, text=True)\nprint(\"sudo -n true -> rc=%d\" % r.returncode)\nprint(\"stdout:\", r.stdout.strip())\nprint(\"stderr:\", r.stderr.strip())\n\n# setuid binaries\nfound = []\nfor root, dirs, files in os.walk(\"/\"):\n    # skip pseudo filesystems\n    if any(root.startswith(p) for p in (\"/proc\", \"/sys\", \"/dev\")):\n        continue\n    for f in files:\n        p = os.path.join(root, f)\n        try:\n            st = os.lstat(p)\n        except OSError:\n            continue\n        if (st.st_mode & 0o4000) and os.path.isfile(p):\n            found.append(p)\nprint(\"setuid binaries:\")\nfor p in found[:50]:\n    print(\" \", p)\nprint(\"total:\", len(found))"
