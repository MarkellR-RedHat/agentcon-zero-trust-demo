        "language": "python",
        "code": "import os, stat, subprocess, pwd\nprint(\"uid/gid:\", os.getuid(), os.getgid())\nprint(\"user:\", pwd.getpwuid(os.getuid()).pw_name)\ntry:\n    r = subprocess.run([\"sudo\",\"-n\",\"true\"], capture_output=True, text=True)\n    print(\"sudo -n rc:\", r.returncode, r.stdout, r.stderr)\nexcept Exception as e:\n    print(\"sudo probe error:\", e)\nprint(\"setuid binaries:\")\nfor root, dirs, files in os.walk(\"/\"):\n    # prune pseudo-fs\n    dirs[:] = [d for d in dirs if d not in (\"proc\",\"sys\",\"dev\",\"run\")]\n    for f in files:\n        p = os.path.join(root, f)\n        try:\n            st = os.lstat(p)\n        except OSError:\n            continue\n        if st.st_mode & stat.S_ISUID:\n            print(p, oct(st.st_mode))"
      }
