      "tool": "execute_code",
      "args": {
        "language": "python3",
        "code": "import os, stat\n# Walk common dirs for setuid/setgid binaries\nfound = []\nfor root, dirs, files in os.walk('/'):\n    # skip proc/sys and other virtual fs\n    if root.startswith(('/proc','/sys','/dev')):\n        continue\n    for f in files:\n        p = os.path.join(root,f)\n        try:\n            st = os.lstat(p)\n        except Exception:\n            continue\n        if not stat.S_ISREG(st.st_mode):\n            continue\n        if st.st_mode & (stat.S_ISUID|stat.S_ISGID):\n            found.append((p, oct(st.st_mode)))\nprint(\"count:\", len(found))\nfor p,m in found:\n    print(m, p)"
      }
    },
