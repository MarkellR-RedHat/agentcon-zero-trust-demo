# ============================================================
# Zero Trust Agents Demo - Configuration
# ============================================================
# Copy this to .env and edit as needed:
#   cp .env.example .env
# ============================================================

# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ============================================================
# Demo Mode
# ============================================================
# "simulation" = pre-scripted interactions, no external deps
# "live"       = real model via vLLM, real tools via MCP
DEMO_MODE=simulation

# ============================================================
# vLLM Configuration (live mode only)
# ============================================================
# Any vLLM-compatible endpoint works here.
# Model size doesn't change the demo flow.

# Full size (H200, A100, multi-GPU)
VLLM_ENDPOINT=http://localhost:8080/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
VLLM_API_KEY=

# Smaller GPU option (A10, L4, T4, 3090)
# VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Even lighter option
# VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ============================================================
# MCP Server (live mode only)
# ============================================================
MCP_SERVER_URL=http://localhost:9000

# ============================================================
# MLflow (optional)
# ============================================================
# Traces show up in the demo UI regardless.
# Set these if you also want traces logged to an MLflow instance.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=zero-trust-agents

# ============================================================
# OpenShift AI (live mode on OpenShift only)
# ============================================================
OPENSHIFT_AI_ENDPOINT=
OPENSHIFT_AI_TOKEN=
