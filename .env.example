# Server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Mode: "simulation" (default, no external deps) or "live" (requires vLLM + MCP)
DEMO_MODE=simulation

# vLLM Configuration (live mode only)
VLLM_ENDPOINT=http://localhost:8080/v1
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
VLLM_API_KEY=

# MCP Server (live mode only)
MCP_SERVER_URL=http://localhost:9000

# MLflow (optional, traces rendered in UI regardless)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=zero-trust-agents

# OpenShift AI (live mode only)
OPENSHIFT_AI_ENDPOINT=
OPENSHIFT_AI_TOKEN=
